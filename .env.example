APP_ENV=development
API_PORT=8000
FRONTEND_PORT=4200
DATABASE_URL=
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tutoria
DB_USER=tutoria
DB_PASSWORD=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DEFAULT_PROVIDER=openai
# Desarrollo local ficticio. CAS real requiere parámetros autorizados por TI.
AUTH_MODE=mock
AUTH_MOCK_USER=student
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=8
AUTH_CALLBACK_URL=http://localhost:4200/api/v1/auth/callback
AUTH_FRONTEND_URL=http://localhost:4200/inicio
AUTH_LOGIN_URL=http://localhost:4200/login
AUTH_ALLOWED_DOMAINS=est.ups.edu.ec
# Para habilitar docentes: est.ups.edu.ec,ups.edu.ec
CAS_LOGIN_URL=
CAS_VALIDATE_URL=
CAS_SERVICE_PARAMETER=service
CAS_TICKET_PARAMETER=ticket
CAS_EMAIL_ATTRIBUTE=email
CAS_ID_ATTRIBUTE=uid
CAS_FIRST_NAME_ATTRIBUTE=givenName
CAS_LAST_NAME_ATTRIBUTE=sn

# Documentos privados; limite de 10 MiB
DOCUMENT_STORAGE_PATH=uploads/documents
DOCUMENT_MAX_BYTES=10485760
# Segmentacion por caracteres Unicode, no tokens del modelo
DOCUMENT_CHUNK_CHARS=1000
DOCUMENT_CHUNK_OVERLAP=150
EXTRACTION_TIMEOUT_SECONDS=15
# Modelo local: pesos publicos fijados en model_spec.py; nunca claves en Angular
EMBEDDING_MODEL_PATH=models/e5-small
EMBEDDING_TIMEOUT_SECONDS=180
