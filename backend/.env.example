DB_USER=tutoria
DB_PASSWORD=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DEFAULT_PROVIDER=openai
# Desarrollo local ficticio. CAS real requiere parámetros autorizados por TI.
